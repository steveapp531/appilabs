# ---------- Core ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the app. Needed for correct client IPs and rate limiting.
TRUST_PROXY=1

# ---------- Database (MongoDB) ----------
# Local (docker compose up -d mongo):  mongodb://127.0.0.1:27017/appilabs
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/appilabs?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/appilabs

# ---------- URLs ----------
PUBLIC_SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Comma separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# true in production (HTTPS). Makes the refresh cookie Secure + SameSite=None.
COOKIE_SECURE=false
# One-time token for the browser-based first admin setup at /admin/setup. Remove after use.
SETUP_TOKEN=

# ---------- Email ----------
# log  = write emails to backend/storage/outbox (no credentials needed)
# smtp = send via SMTP
EMAIL_DRIVER=log
EMAIL_FROM=AppiLabs <hello@appilabs.com>
ADMIN_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Payments ----------
# mock     = simulated payments for local demos (never in production)
# paystack = live or test Paystack (use sk_test_... for testing)
# none     = no online payments; enrollments are recorded as "interested"
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=GHS

# ---------- File storage (research and project uploads) ----------
# local = backend/storage/private (development only; hosted filesystems are often ephemeral)
# s3    = any S3-compatible PRIVATE bucket (AWS S3, Cloudflare R2, Backblaze B2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/private
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_MB=10
UPLOAD_MAX_FILES=3
UPLOAD_RETENTION_DAYS=180

# ---------- Automation ----------
# Shared secret for the Python automation jobs (X-API-Key header).
AUTOMATION_API_KEY=

# ---------- Optional ----------
# Vercel deploy hook. When content is published, the frontend rebuilds so prerendered pages update.
VERCEL_DEPLOY_HOOK_URL=
