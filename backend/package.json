{
  "name": "appilabs-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "create-admin": "node --env-file-if-exists=.env src/scripts/createAdmin.js",
    "purge-uploads": "node --env-file-if-exists=.env src/scripts/purgeUploads.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "mongodb-memory-server-core": "^10.1.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.5"
  }
}
