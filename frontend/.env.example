# URL of the backend API (Render). No trailing slash.
VITE_API_URL=http://localhost:4000
# Public URL of this site. Used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=http://localhost:5173
# Google Analytics 4 measurement ID (G-XXXXXXX). Loaded only after the visitor accepts analytics.
VITE_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification code (content attribute only).
VITE_GSC_VERIFICATION=
