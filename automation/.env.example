# Backend URL (local for development; Vercel injects this through a service binding)
APPILABS_API_URL=http://localhost:4000
# Must equal AUTOMATION_API_KEY on the backend
APPILABS_AUTOMATION_API_KEY=
# Set in Vercel to authorize the scheduled reports endpoint; do not commit the secret.
CRON_SECRET=
# console | file | smtp
NOTIFY_MODE=console
OUTPUT_DIR=./output
# Only for NOTIFY_MODE=smtp. Reports go to your team, never to customers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AppiLabs Reports <reports@appilabs.com>
REPORT_TO=
