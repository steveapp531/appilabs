{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [{ "source": "/((?!assets/|resources/).*)", "destination": "/app.html" }]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/index.js",
      "installCommand": "npm ci",
      "functions": {
        "src/index.js": {
          "includeFiles": "openapi.yaml"
        }
      }
    },
    "automation": {
      "root": "automation",
      "runtime": "python",
      "entrypoint": "app:app",
      "bindings": [{ "type": "service", "service": "backend", "format": "url", "env": "APPILABS_API_URL" }]
    }
  },
  "rewrites": [
    { "source": "/api/cron/reports", "destination": { "service": "automation" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [{ "path": "/api/cron/reports", "schedule": "0 7 * * *" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
